  }, {
    "name" : "Rule1",
    "enabled" : true,
    "filter" : "ExcludeOthers",
    "dataPlatform" : "dataverseSource",
    "schema" : [ "*" ],
    "dataset" : [ "accounts", "contacts" ],
    "override" : true
  } ]
}