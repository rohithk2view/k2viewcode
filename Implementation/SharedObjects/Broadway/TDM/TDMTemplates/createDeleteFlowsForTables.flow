tags: TDM
stages:
  Stage 1:
    actors:
      Set Target Environment:
        parent: FabricSet
        in:
          key:
            const: ENVIRONMENT
            default: false
          value:
            const: null
            external: TARGET_ENVIRONMENT
            default: false
      Create Folder For Delete:
        parent: InnerFlow
        in:
          flowName:
            const: createFolderForFlows
          LU_NAME:
            external: LU_NAME
            schema: string
            mandatory: false
          FOLDER_NAME:
            const: DeleteFlows
            schema: string
            mandatory: false
      Get Delete Table Prefix:
        parent: FabricSetRead
        in:
          key:
            const: TDM_DELETE_TABLES_PREFIX
            default: false
      geLuTables:
        parent: LuFunction
        in:
          functionName:
            const: getLuTables
          luName:
            external: LU_NAME
            schema: string
            mandatory: false
        out:
          res:
            schema: '#ref'
  Stage 8:
    actors:
      Get Type Of Table:
        parent: LuFunction
        in:
          functionName:
            const: fnGetObjectType
          luName:
            external: LU_NAME
            schema: string
            mandatory: false
            createdBy: functionName
          name:
            link:
              path: geLuTables/res
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: functionName
        out:
          result:
            schema: string
  Stage 10:
    dependsOn: Stage 8
    actors:
      If Table?:
        parent: Equals
        condition: result
        in:
          a:
            link: Get Type Of Table/result
            schema: string
          b:
            const: TABLE
            schema: string
      Create Delete Table And Population:
        parent: InnerFlow
        in:
          flowName:
            const: createDeleteTablesAndPopulations
          TABLE_PREFIX:
            link: Get Delete Table Prefix/result
            schema: string
            mandatory: false
            createdBy: flowName
          TABLE_NAME:
            link:
              path: geLuTables/res
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          OVERRIDE_EXISTING_FLOWS:
            external: OVERRIDE_EXISTING_FLOWS
            schema: boolean
            mandatory: false
            createdBy: flowName
          LU_NAME:
            external: LU_NAME
            schema: string
            editor:
              id: com.k2view.logicalUnit
              addEmptyEntry: true
            mandatory: false
            createdBy: flowName
          TARGET_SCHEMA:
            external: TARGET_SCHEMA
            schema: string
            mandatory: false
            createdBy: flowName
          TARGET_INTERFACE:
            external: TARGET_INTERFACE
            schema: string
            mandatory: false
            createdBy: flowName
          useFabric:
            external: useFabric
            schema: boolean
            mandatory: false
            createdBy: flowName
          INTERFACE_TYPE:
            external: INTERFACE_TYPE
            schema: string
            mandatory: false
            createdBy: flowName
      Flow Name:
        parent: StringFormat
        in:
          format:
            const: delete_${0}.flow
          params:
            link:
              path: geLuTables/res
              iterate: Iterate
              pos: 0
    split: '--------------------'
  Stage 2:
    else: true
    dependsOn: Stage 8
    actors:
      Document?:
        parent: Equals
        in:
          a:
            link: Get Type Of Table/result
            schema: string
          b:
            const: DOC_MAIN
            schema: string
  Stage 3:
    last: 1
    dependsOn: Stage 10
    actors:
      createDeleteTableFromTargetFlow1:
        parent: InnerFlow
        in:
          flowName:
            const: createDeleteTableFromTargetFlow
          INTERFACE_TYPE:
            external: INTERFACE_TYPE
            schema: string
            mandatory: false
            createdBy: flowName
          LU_TABLE:
            link:
              path: geLuTables/res
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          TARGET_INTERFACE:
            external: TARGET_INTERFACE
            schema: string
            mandatory: false
            createdBy: flowName
          TARGET_SCHEMA:
            external: TARGET_SCHEMA
            schema: string
            mandatory: false
            createdBy: flowName
          TARGET_TABLE:
            link:
              path: geLuTables/res
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          luType:
            external: LU_NAME
            schema: string
            mandatory: false
            createdBy: flowName
          useFabric:
            const: true
            schema: boolean
            mandatory: false
            createdBy: flowName
          FLOW_NAME:
            link: Flow Name/string
            schema: string
            mandatory: false
            createdBy: flowName
    split: '--------------------'
  Stage 4:
    last: 1
    dependsOn: Stage 2
    actors:
      Equals3:
        parent: Equals
        condition: result
        in:
          a:
            link: Document?/result
            schema: boolean
          b:
            const: true
            schema: boolean
      List of Documents:
        parent: ArrayBuilder
        in:
          input:
            link:
              path: geLuTables/res
              iterate: Iterate
        out:
          array:
            schema: '#ref'
      Create Delete Flow For One Data Set:
        parent: InnerFlow
        in:
          flowName:
            const: CreateDeleteFlowForOneDataSet
          luName:
            external: LU_NAME
            schema: string
            mandatory: false
            createdBy: flowName
          sourceTable:
            link:
              path: geLuTables/res
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          targetDbInterface:
            external: TARGET_INTERFACE
            schema: string
            mandatory: false
            createdBy: flowName
          targetDbSchema:
            external: TARGET_SCHEMA
            schema: string
            mandatory: false
            createdBy: flowName
          targetDbTable:
            link:
              path: geLuTables/res
              iterate: Iterate
            schema: string
            mandatory: false
            createdBy: flowName
          sourceDBIneterface:
            external: SOURCE_INTERFACE
            schema: string
            mandatory: false
            createdBy: flowName
          sourceDBSchema:
            external: SOURCE_SCHEMA
            schema: string
            mandatory: false
            createdBy: flowName
          INTERFACE_TYPE:
            external: INTERFACE_TYPE
            schema: string
            mandatory: false
            createdBy: flowName
          rootFieldName:
            external: rootFieldName
            schema: string
            mandatory: false
            createdBy: flowName
    split: '--------------------'
  Stage 5:
    last: 1
    else: true
    dependsOn: Stage 2
  Stage 6:
    actors:
      create Delete From Target Flow:
        parent: createDeleteAllTablesFlow
        in:
          INTERFACE_TYPE:
            external: INTERFACE_TYPE
            schema: string
            mandatory: false
            createdBy: flowName
          documents:
            link: List of Documents/array
            schema: '#ref'
            mandatory: false
            createdBy: flowName
          LU_NAME:
            external: LU_NAME
  Stage 7:
    actors:
      Add Tables to LU's Schema:
        parent: InnerFlow
        in:
          flowName:
            const: AddDeleteTablesToSchema
          luName:
            external: LU_NAME
            schema: string
            mandatory: false
          schemaName:
            external: TARGET_SCHEMA
            schema: string
            mandatory: false
          interfaceName:
            external: TARGET_INTERFACE
            schema: string
            mandatory: false
          useFabric:
            external: useFabric
            schema: boolean
            mandatory: false
schemas:
  geLuTables.out.res:
    type: array
    items:
      type: string
  List of Documents.out.array:
    type: array
    items:
      type: string
  create Delete From Target Flow.in.documents:
    type: array
    items:
      type: string
