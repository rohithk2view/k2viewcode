tags: DeleteFlows
stages:
  Description:
    remark: |-
      This flow demonstrates the following:
      1. A table flow with field transformations:
        a. Changing the sequential value of a field
      2. Supporting sequence replacement:
        a. Regular sequence replacement
        b. Sequence Caching - when a value was already replaced at a previous stage/actor, the new value will be taken from cache.
    transactional: false
  Initiate:
    transactional: false
    actors:
      Initiate TDM Delete:
        parent: InitiateTDMLoad_Actor
        in:
          iid:
            external: iid
          luName:
            external: luName
          syncMode:
            external: syncMode
  Get Fabric Table Data:
    transactional: false
    actors:
      Get Table Data:
        parent: DbCommand
        in:
          interface:
            const: fabric
          sql:
            const: select distinct customer_id ,contract_id,contract_ref_id  from
              Customer.TAR_contract
        out:
          result:
            schema: '#ref'
  Stage 2:
    transactional: false
    actors:
      StringFormat1:
        parent: StringFormat
        in:
          format:
            const: "{\r\n  \"query\": {\r\n    \"bool\": {\r\n      \"must\": [\r\n\
              \        { \"term\": { \"customer_id\":${CUSTOMER_ID} }},\r\n      \
              \    { \"term\": { \"contract_id\": ${CONTRACT_ID} }},         \r\n\t\
              \t{ \"term\": { \"contract_ref_id\": ${contract_ref_id}}}         \r\
              \n      ]\r\n    }\r\n  }\r\n}"
          CUSTOMER_ID:
            link:
              path: Get Table Data/result/CUSTOMER_ID
              iterate: Iterate
              pos: 0
            schema: '#ref'
            mandatory: false
          CONTRACT_ID:
            link:
              path: Get Table Data/result/CONTRACT_ID
              iterate: Iterate
            schema: '#ref'
            mandatory: false
          contract_ref_id:
            link:
              path: Get Table Data/result/CONTRACT_REF_ID
              iterate: Iterate
            schema: '#ref'
            mandatory: false
  Delete Data From Target:
    last: 1
    actors:
      Error Handler:
        parent: ErrorHandler
        error: result
        in:
          config:
            const:
            - exceptionKey: java.lang.Exception
              conditions:
                message: ''
              actions:
                suppress: false
                log: true
                flowName: PopulateTableErrorsWithFailed
      ESDeleteByQuery1:
        parent: ESDeleteByQuery
        in:
          interface:
            const: ES_Load_Demo
          index:
            const: contractdemo
          ESQuery:
            link: StringFormat1/string
  Stage 1: {
    }
schemas:
  Get Table Data.out.result:
    type: array
    items:
      type: object
      properties:
        CUSTOMER_ID:
          type: integer
        CONTRACT_ID:
          type: integer
        CONTRACT_REF_ID:
          type: integer
  StringFormat1.in.CUSTOMER_ID:
    type: array
    items:
      type: integer
  StringFormat1.in.CONTRACT_ID:
    type: array
    items:
      type: integer
  StringFormat1.in.contract_ref_id:
    type: array
    items:
      type: integer
