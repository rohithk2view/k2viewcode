tags: Dataverse
stages:
  Inputs:
    actors:
      Source Interface:
        parent: Const
        remark: The Source Interface
        in:
          value:
            const: null
            external: sourceInterface
            schema: string
        out:
          value:
            schema: string
      Source Table Name:
        parent: Const
        remark: The ame of the source table.
        in:
          value:
            const: null
            external: sourceTableName
            schema: string
        out:
          value:
            schema: string
      GUI Filter:
        parent: Const
        in:
          value:
            const: null
            external: filterGUI
        out:
          value:
            schema: string
      Source Schema:
        parent: Const
        remark: The Source Schema
        disabled: true
        in:
          value:
            const: null
            external: sourceSchema
            schema: string
        out:
          value:
            schema: string
      Where Claוse:
        parent: Const
        remark: The Where Cluase created based on the parameters when the task was
          created/edited.
        disabled: true
        in:
          value:
            const: null
            external: whereClause
            schema: string
        out:
          value:
            schema: string
      Query's Parameters Values as a String:
        parent: Const
        remark: A String including the list of  parameters sent for the query. The
          values are separated by global - TDM_PARAMETERS_SEPARATOR
        disabled: true
        in:
          value:
            const: null
            external: paramtersStr
            schema: string
        out:
          value:
            schema: string
      Array of TheQuery's Parameters Values:
        parent: Const
        remark: An array with the values sent to the query.
        disabled: true
        in:
          value:
            const: null
            external: queryParameters
            schema: string
        out:
          value:
            schema: string
      Select Query Statement:
        parent: Const
        remark: The Sql statement including the where clause if exists to select the
          data from source.
        disabled: true
        in:
          value:
            const: null
            external: selectStatement
            schema: string
        out:
          value:
            schema: string
      Count Query Statement:
        parent: Const
        remark: The Sql statement including the where clause if exists to count the
          total number of records to be loaded.
        disabled: true
        in:
          value:
            const: null
            external: countStatement
            schema: string
        out:
          value:
            schema: string
      'Array of The Query''s Parameters ':
        parent: Const
        remark: An array with the map of name, type and value of each parameter sent
          in the filter.
        disabled: true
        in:
          value:
            const: null
            external: filterParametersInfo
            schema: Any
        out:
          value:
            schema: string
  Prepare for fetch:
    actors:
      ParseFilter:
        parent: LuFunction
        in:
          functionName:
            const: dataverseConvertTDMFilter
          filter:
            link: GUI Filter/value
            schema: any
            mandatory: false
        out:
          result:
            schema: '#ref'
  Execute Query:
    transactional: false
    actors:
      DataverseTableQuery1:
        parent: DataverseTableQuery
        in:
          headers:
            const:
              If-None-Match: null
              Prefer: odata.include-annotations=Microsoft.Dynamics.CRM.lookuplogicalname
          expand_lookups:
            const: true
          fields:
            const: ''
          interface:
            link: Source Interface/value
          table:
            link: Source Table Name/value
          filter:
            link: ParseFilter/result
        out:
          result:
            external: result
            schema: '#ref'
      Dummy Count:
        parent: Const
        in:
          value:
            const: -1
            schema: integer
        out:
          value:
            external: tableCount
            schema: integer
