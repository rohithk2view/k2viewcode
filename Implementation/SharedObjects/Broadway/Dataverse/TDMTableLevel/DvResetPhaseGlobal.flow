tags: Dataverse
stages:
  Reset load phase:
    actors:
      SetLoadPhase:
        parent: FabricSet
        in:
          key:
            const: DATAVERSE_LOAD_PHASE
  Outputs:
    actors:
      DoNotSuppress:
        parent: Const
        in:
          value:
            const: false
            schema: boolean
        out:
          value:
            external: result
            schema: boolean
