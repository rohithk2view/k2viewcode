tags: LoadFlows
stages:
  Inputs:
    transactional: false
    actors:
      Target Interface:
        parent: Const
        remark: The target interface
        in:
          value:
            const: null
            external: targetInterface
            schema: string
        out:
          value:
            schema: string
      Target Schema:
        parent: Const
        remark: The target Schema
        in:
          value:
            const: null
            external: targetSchema
            schema: string
        out:
          value:
            schema: string
      Target Table Name:
        parent: Const
        remark: The name of the target table.
        in:
          value:
            const: null
            external: targetTable
            schema: string
        out:
          value:
            schema: string
      Get Commit Size:
        parent: FabricSetRead
        in:
          key:
            const: TDM_REF_UPD_SIZE
            default: false
        out:
          result:
            schema: integer
      'Table''s fields Names ':
        parent: Const
        in:
          value:
            const: null
            external: fieldsArray
            schema: '#ref'
        out:
          value:
            schema: '#ref'
  Stage 1:
    transactional: false
    actors:
      StringFormat1:
        parent: StringFormat
        in:
          format:
            const: /opt/apps/fabric/workspace/project/project-resources/Files/${tablename}.csv
          tablename:
            link: Target Table Name/value
            schema: string
            mandatory: false
  Load Data To Target:
    transactional: false
    actors:
      Input Records:
        parent: Const
        in:
          value:
            const: null
            external: inputRecords
            schema: '#ref'
        out:
          value:
            schema: '#ref'
  Stage 4:
    transactional: false
    actors:
      CsvBuilder1:
        parent: CsvBuilder
        in:
          maps:
            link:
              path: Input Records/value
              iterate: Iterate
  Stage To Commit every Commit Size:
    last: 1
    transactional: false
    actors:
      FileWrite1:
        parent: FileWrite
        in:
          interface:
            const: file://
          path:
            link: StringFormat1/string
          stream:
            link: CsvBuilder1/csv
  Stage 3:
    transactional: false
  Stage 2:
    transactional: false
schemas:
  Table's fields Names .in.value:
    type: array
    items:
      type: string
  Table's fields Names .out.value:
    type: array
    items:
      type: string
  Input Records.in.value:
    type: array
    items: {
      }
  Input Records.out.value:
    type: array
    items:
      type: object
      properties:
        contract_ref_id:
          type: integer
        offer_ref_id:
          type: integer
        offer_contract_description:
          type: string
