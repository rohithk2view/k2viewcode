tags: LoadFlows,CustomTableLevel,TableToTableLoad,Trash
stages:
  Stage 2:
    transactional: false
  Inputs:
    transactional: false
    actors:
      Target Interface:
        parent: Const
        remark: The target interface
        in:
          value:
            const: null
            external: targetInterface
            schema: string
        out:
          value:
            schema: string
      Target Schema:
        parent: Const
        remark: The target Schema
        in:
          value:
            const: null
            external: targetSchema
            schema: string
        out:
          value:
            schema: string
      Target Table Name:
        parent: Const
        remark: The name of the target table.
        in:
          value:
            const: null
            external: targetTable
            schema: string
        out:
          value:
            schema: string
      'Table''s fields Names ':
        parent: Const
        in:
          value:
            const: null
            external: fieldsArray
            schema: '#ref'
        out:
          value:
            schema: '#ref'
      Get Commit Size:
        parent: FabricSetRead
        in:
          key:
            const: TDM_REF_UPD_SIZE
            default: false
        out:
          result:
            schema: integer
  Stage 1:
    transactional: false
    actors:
      Input Records:
        parent: Const
        in:
          value:
            const: null
            external: inputRecords
            schema: '#ref'
        out:
          value:
            schema: '#ref'
      GetPIIFields:
        parent: MTableLookup
        in:
          mtable:
            const: catalog_field_info
          mtableCaseSensitive:
            const: false
          dataPlatform:
            link: Target Interface/value
            schema: string
            mandatory: false
          dataset:
            link: Target Table Name/value
            schema: string
            mandatory: false
          pii:
            const: true
            schema: boolean
            mandatory: false
          schema:
            link: Target Schema/value
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
      GetPKFields:
        parent: MTableLookup
        in:
          mtable:
            const: catalog_field_info
          mtableCaseSensitive:
            const: false
          dataPlatform:
            link: Target Interface/value
            schema: string
            mandatory: false
          dataset:
            link: Target Table Name/value
            schema: string
            mandatory: false
          pk:
            const: true
            schema: boolean
            mandatory: false
          schema:
            link: Target Schema/value
            schema: string
            mandatory: false
        out:
          result:
            schema: '#ref'
  Load Data To Target:
    transactional: true
    actors:
      Load Table:
        parent: DbLoad
        in:
          interface:
            const: null
            external: targetInterface
          command:
            const: update
          schema:
            const: null
            external: targetSchema
          table:
            const: null
            link: Target Table Name/value
          fields:
            const: null
            link: GetPIIFields/result/field
          keys:
            const: null
            link: GetPKFields/result/field
          dialect:
            const: oracle
          batch:
            const: true
          __active_environment:
            const: target
            schema: string
            mandatory: false
          params:
            link:
              path: Input Records/value
              iterate: Iterate
      Count Records:
        parent: JavaScript
        in:
          script:
            const: |-
              var i = flowGlobals.recCount;
              var result = false;
              if (i == null) {
                  i = 0;
              }
              flowGlobals.recCount = ++i;
              if (i%commitSize === 0) {
                  result = true;
              }
              result;
          commitSize:
            link: Get Commit Size/result
            schema: boolean
            mandatory: false
        out:
          result:
            schema: integer
      Count1:
        parent: Count
        out:
          value:
            schema: integer
  Stage To Commit every Commit Size:
    last: 1
    transactional: false
    actors:
      Commit?:
        parent: Equals
        condition: result
        in:
          a:
            link: Count Records/result
            schema: boolean
          b:
            const: true
            schema: boolean
  Return Current Count:
    transactional: false
    actors:
      Count:
        parent: JavaScript
        in:
          script:
            const: flowGlobals.recCount;
        out:
          result:
            schema: integer
      Return Table Count:
        parent: Const
        in:
          value:
            const: null
            link: Count1/value
        out:
          value:
            external: result
            schema: integer
schemas:
  Table's fields Names .in.value:
    type: array
    items:
      type: string
  Table's fields Names .out.value:
    type: array
    items:
      type: string
  Input Records.in.value:
    type: array
    items: {
      }
  Input Records.out.value:
    type: array
    items:
      type: object
      properties:
        contract_ref_id:
          type: integer
        offer_ref_id:
          type: integer
        offer_contract_description:
          type: string
  GetPIIFields.out.result:
    type: array
    items:
      type: object
      properties:
        dataPlatform:
          type: string
        schema:
          type: string
        dataset:
          type: string
        class:
          type: string
        field:
          type: string
        sqlDataType:
          type: string
        sourceDataType:
          type: string
        sourceEntityType:
          type: string
        sourceNullable:
          type: string
        columnSize:
          type: string
        definedBy:
          type: string
        ordinalPosition:
          type: string
        classification:
          type: string
        nullPercentage: {
          }
        idx: {
          }
        pii:
          type: string
        pk: {
          }
        encodingType: {
          }
        V2: {
          }
        V24: {
          }
        V3: {
          }
        V22: {
          }
  GetPKFields.out.result:
    type: array
    items:
      type: object
      properties:
        dataPlatform:
          type: string
        schema:
          type: string
        dataset:
          type: string
        class:
          type: string
        field:
          type: string
        sqlDataType:
          type: string
        sourceDataType:
          type: string
        sourceEntityType:
          type: string
        sourceNullable:
          type: string
        columnSize:
          type: string
        definedBy:
          type: string
        ordinalPosition:
          type: string
        classification: {
          }
        nullPercentage: {
          }
        idx:
          type: string
        pii: {
          }
        pk:
          type: string
        encodingType: {
          }
        V2: {
          }
        V24: {
          }
        V3: {
          }
        V22: {
          }
