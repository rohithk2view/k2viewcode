                            "name": "Set _value",
                            "actorType": {
                                "parentType": "JavaScript",
                                "inputs": [
                                    {
                                        "name": "script",
                                        "const": "var value = null;\nif (map.get('_value') != null) {\n    value = map.get('value');\n} else {\n    if (map.get(tableName) != null) {\n        value = map.get(tableName);\n    }\n}\nvalue;"
                                    },
                                    {
                                        "name": "map",
                                        "schema": {
                                            "type": "object"
                                        },
                                        "mandatory": false
                                    },
                                    {
                                        "name": "tableName",
                                        "const": "orders",
                                        "schema": {
