stages:
  Input:
    actors:
      PopulationArgs:
        parent: PopulationArgs
        readonly: true
        in:
          customer_id:
            external: customer_id
            schema: any
            mandatory: false
          activity_id:
            external: activity_id
            schema: any
            mandatory: false
          activity_date:
            external: activity_date
            schema: any
            mandatory: false
          activity_note:
            external: activity_note
            schema: any
            mandatory: false
      SyncDeleteMode:
        parent: SyncDeleteMode
        in:
          interface:
            schema: any
          table:
            const: null
            external: table
  Source:
    actors:
      Get Sync Source Data Indicator:
        parent: InnerFlow
        condition: value
        in:
          flowName:
            const: GetSyncSourceDataIndicator
        out:
          value:
            schema: boolean
      Query:
        parent: SourceDbQuery
        in:
          interface:
            const: CRM_DB
          sql:
            const: select * from public.activity
          parent_rows:
            link: PopulationArgs/parent_rows
        out:
          result:
            schema: '#ref'
      Get SEQ_CACHE_INTERFACE:
        parent: FabricSetRead
        in:
          key:
            const: SEQ_CACHE_INTERFACE
            default: false
      Get MASKING_CACHE_TTL:
        parent: FabricSetRead
        in:
          key:
            const: MASKING_CACHE_TTL
            default: false
  Mask Data Based On Catalog:
    actors:
      Catalog Masking Mapper:
        parent: CatalogMaskingMapper
        in:
          interface:
            const: null
            link: Get SEQ_CACHE_INTERFACE/result
          mtable:
            schema: any
          dataPlatform:
            const: CRM_DB
          schema:
            const: public
          dataset:
            const: activity
          ttl:
            link: Get MASKING_CACHE_TTL/result
            schema: number
            mandatory: false
          values:
            link: Query/result
  LU Table:
    last: 1
    actors:
      activity:
        parent: DbLoad
        in:
          interface:
            const: fabric
          schema:
            const: null
            external: schema
          table:
            const: null
            external: table
          fields:
            const:
            - customer_id
            - activity_id
            - activity_date
            - activity_note
          keys:
            const:
            - activity_id
          dialect:
            const: sqlite
          customer_id:
            schema: any
          activity_id:
            schema: any
          activity_date:
            schema: any
          activity_note:
            schema: any
          params:
            link:
              path: Catalog Masking Mapper/values
              iterate: Iterate
  Post Load: {
    }
schemas:
  Query.out.result:
    type: object
    properties:
      customer_id:
        type: {
          }
      activity_id:
        type: {
          }
      activity_date:
        type: {
          }
      activity_note:
        type: {
          }
